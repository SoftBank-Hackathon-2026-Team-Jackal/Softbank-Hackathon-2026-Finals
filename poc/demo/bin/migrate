#!/usr/bin/env bash
# 앱과 DB를 한 번에 옮긴다. Phase A: 트래픽 env-a → env-b, app-a 종료. Phase B: DB pg-a → pg-b 전환.
# 사용법: bin/migrate            (bin/prepare 직후 상태에서)
#         SPLIT_SEC=10 bin/migrate   50:50으로 섞어 두는 시간 (기본 5초)
#         SWITCHOVER=classic bin/migrate  기존 전환 스크립트 (PAUSE 안에서 체크섬 검증)
source "$(dirname "$0")/lib.sh"

step "Phase A: 트래픽 50:50"
bin/weight 50 50
sleep "${SPLIT_SEC:-5}"
step "Phase A: 트래픽 전부 env-b"
bin/weight 0 100
sleep 3
step "Phase A: app-a 종료 (drain 후)"
bin/demo stop app-a 2>&1 | tail -1

step "Phase B: DB 전환 pg-a → pg-b ($SWITCHOVER)"
$T "$SW" pg-a pg-b

step "완료"
curl -s "localhost:${DEMO_PORT:-8090}/api/stats"; echo
